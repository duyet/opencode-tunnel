# opencode-tunnel configuration
#
# Copy to .env and source it, or just export these before running the script:
#     export OC_PORT=4096
#     ./opencode-tunnel start
#
# Everything here has a working default except OC_DIR (defaults to $PWD) and
# OC_PASSWORD (generated on `setup`).

# Workspace directory the agent is allowed to operate in.
OC_DIR=/workspace

# Interface and port for the local opencode server.
# Keep OC_HOST on loopback: the tunnel should be the only way in.
OC_HOST=127.0.0.1
OC_PORT=4096

# HTTP Basic auth password for user "opencode".
# Leave unset to have `setup` generate one with 256 bits of entropy.
# OC_PASSWORD=

# Where the tunnel keeps its state (config, pids, logs). Mode 700.
# OT_STATE_DIR=$HOME/.local/state/opencode-tunnel
